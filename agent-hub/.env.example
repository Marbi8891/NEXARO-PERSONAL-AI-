OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
# Relative paths are resolved from the repository root, not from agent-hub/.
AGENT_CATALOGUE_PATH=docs/agents/catalogue.json
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
WORKSPACE_DIR=./workspace
COMMAND_TIMEOUT_SECONDS=120
CODING_AGENT_MAX_ITERATIONS=20
# Coding agent: off by default. To enable it, set both values (generate the token yourself, never commit it).
CODING_AGENT_ENABLED=false
AGENT_HUB_API_TOKEN=
# run_command = arbitrary code execution (python, node, pip...). Only enable inside the container.
CODING_AGENT_ALLOW_COMMANDS=false
