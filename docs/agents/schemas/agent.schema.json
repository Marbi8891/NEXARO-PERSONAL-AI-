{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXARO Agent Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "category",
    "model",
    "system_prompt",
    "tools",
    "permissions",
    "memory",
    "enabled"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500
    },
    "category": {
      "enum": [
        "general",
        "development",
        "cybersecurity",
        "ai_data",
        "education",
        "business",
        "research",
        "productivity",
        "custom"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "system_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,63}$"
      },
      "uniqueItems": true,
      "maxItems": 30
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem",
        "terminal",
        "network"
      ],
      "properties": {
        "filesystem": {
          "enum": [
            "none",
            "read_only",
            "write_with_approval"
          ]
        },
        "terminal": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "scope"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "none",
            "conversation",
            "workspace",
            "global"
          ]
        }
      }
    },
    "enabled": {
      "type": "boolean"
    }
  }
}
