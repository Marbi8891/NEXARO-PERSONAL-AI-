# Copia a .env (ignorado por git). No guardes aquí secretos reales en el ejemplo.
NEXARO_ENV=development            # development | production
DATABASE_PATH=./data/nexaro.db
FRONTEND_PATH=./frontend
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
COOKIE_SECURE=false               # en production debe ser true y los orígenes https

# AI Gateway (la nube está DESACTIVADA por defecto; los datos no salen de la máquina)
AI_PROVIDER_ORDER=ollama          # orden de rutas/respaldo: ollama,bedrock,sagemaker
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_CHARS=32000
AI_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=1                  # solo ante indisponibilidad
# Para activar la nube hacen falta TODAS estas (si falta alguna, la app no arranca):
# AI_ALLOW_CLOUD=true
# AI_CLOUD_MONTHLY_BUDGET_USD=20
# AWS_REGION=eu-west-1
# BEDROCK_MODEL_ID=
# BEDROCK_PRICE_INPUT_PER_1K=       # precio vigente de AWS: VERIFY
# BEDROCK_PRICE_OUTPUT_PER_1K=
# SAGEMAKER_ENDPOINT=
# Credenciales AWS: rol/entorno estándar de AWS, nunca en este archivo.
